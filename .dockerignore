# VCS / CI / editor
.git
.github
.agents
.claude
.codex
.idea
.vscode
.fleet
.nova
.zed

# Secrets - never bake into an image
.env
.env.*
!.env.example
auth.json
*.key
*.pem
backups

# Dependencies & build output (rebuilt inside the image)
node_modules
vendor
public/build
public/hot
public/storage
resources/js/actions
resources/js/routes
resources/js/wayfinder
bootstrap/ssr

# Python ML tooling (disabled in the container: RISK_ML_ENABLED=false)
ml
.venv
**/__pycache__
*.pyc

# Runtime state
bootstrap/cache/*.php
storage/app/**
!storage/app/.gitignore
!storage/app/public/.gitignore
!storage/app/private/.gitignore
storage/framework/cache/**
storage/framework/sessions/**
storage/framework/views/**
storage/logs/**
storage/pail

# Not needed at runtime
tests
docs
scripts
compose*.yaml
docker-compose*.yml
Dockerfile*
*.md
*.dbml
*.mmd
*.docx
~$*
.phpunit.cache
.phpunit.result.cache
npm-debug.log
yarn-error.log
getLoadedConfigurationFiles())
